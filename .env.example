# --- PostgreSQL ---
POSTGRES_USER=trafficlab
POSTGRES_PASSWORD=trafficlab
POSTGRES_DB=trafficlab

# --- Backend ---
# Обязательно смените в проде: openssl rand -hex 32
SECRET_KEY=change-me-in-production
# true, если сайт открыт по HTTPS
COOKIE_SECURE=false
# Максимальный размер загружаемого видео, МБ (nginx пропускает CLIENT_MAX_BODY_SIZE)
MEDIA_MAX_MB=2048
CLIENT_MAX_BODY_SIZE=2100m
# Часовой пояс для «сегодня», рабочих дней и слотов созвонов
APP_TIMEZONE=Europe/Kyiv
# Число воркеров uvicorn
WEB_CONCURRENCY=2
# Пароль демо-пользователей для `python -m app.seed --demo`
SEED_DEMO_PASSWORD=trafficlab123

# --- Порт, на котором открывается сайт ---
APP_PORT=8080

# --- Только для docker-compose.prod.yml ---
# IMAGE_PREFIX=ghcr.io/<owner>/trafficlab
# TAG=latest
